<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gray-100 p-6">

    <div class="mb-3">
        <a href="/" class="text-sm text-indigo-600 font-medium hover:underline">
            Back to Form
        </a>
    </div>

    <h1 class="text-3xl font-bold text-center text-gray-800 mb-8">
        👥 All Registered Users
    </h1>

    <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">

        <% if (!users || users.length === 0) { %>
            <p class="col-span-full text-center text-gray-500">
                No users found
            </p>
        <% } %>

        <% if (users && users.length > 0) { %>
            <% users.forEach(user => { %>

                <div class="bg-white rounded-2xl shadow-md p-6 hover:shadow-xl transition relative">

                    <!-- Delete Button -->
                    <form action="/delete/<%= user._id %>" method="POST" class="absolute top-4 right-4">
                        <button
                            type="submit"
                            class="text-red-500 hover:text-red-700 text-sm font-medium"
                        >
                            🗑 Delete
                        </button>
                    </form>

                    <!-- Avatar -->
                    <div class="w-14 h-14 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xl font-bold mb-4">
                        <%= user.name ? user.name.charAt(0).toUpperCase() : "?" %>
                    </div>

                    <!-- Name -->
                    <h2 class="text-xl font-semibold text-gray-800">
                        <%= user.name || "Unknown User" %>
                    </h2>

                    <!-- Email -->
                    <p class="text-gray-500 text-sm mt-1 break-all">
                        <%= user.email || "No email provided" %>
                    </p>

                    <!-- Age -->
                    <p class="mt-3 text-gray-700">
                        🎂 Age:
                        <span class="font-medium">
                            <%= user.age ? user.age : "N/A" %>
                        </span>
                    </p>

                    <!-- MongoDB ID -->
                    <div class="mt-4 pt-4 border-t text-right text-xs text-gray-400">
                        ID: <%= user._id %>
                    </div>

                </div>

            <% }) %>
        <% } %>

    </div>

</body>
</html>